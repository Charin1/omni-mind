# OmniMind Environment Variables

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///omni_mind.db
CHAT_CONCURRENCY_LIMIT=40
ARTIFACT_CONCURRENCY_LIMIT=8

# LLM Providers (Add keys as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384

# Token & Context Window Limits
DEFAULT_CONTEXT_LIMIT=128000
MAX_TOOL_RESULT_TOKENS=1500

# MCP Server Config (Optional)
MCP_SERVERS_CONFIG=mcp_servers.json

# Observability (optional — see observability/README.md)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

